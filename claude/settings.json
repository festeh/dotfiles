{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 10000,
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.astral.sh)",
      "Bash(uv sync:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run:*)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.github.com)",
      "Bash(python3:*)",
      "WebFetch(domain:miniflux.app)",
      "Bash(gcloud storage ls:*)",
      "Bash(gcloud storage cat:*)",
      "Bash(gcloud storage du:*)",
      "Bash(gcloud config get-value:*)",
      "Bash(gcloud projects list:*)",
      "Bash(gcloud auth list:*)"
    ],
    "deny": [
      "SendFeedback"
    ],
    "defaultMode": "auto"
  },
  "model": "fable",
  "skillOverrides": {
    "docs": "off",
    "docx": "off",
    "pptx": "off",
    "xlsx": "off",
    "pdf": "off",
    "google-workspace": "off",
    "morning": "off",
    "import-memory": "off",
    "anthropic-skills:skill-creator": "off"
  },
  "deniedMcpServers": [
    {
      "serverName": "claude.ai Asana"
    },
    {
      "serverName": "claude.ai Box"
    },
    {
      "serverName": "claude.ai Calendly"
    },
    {
      "serverName": "claude.ai Canva"
    },
    {
      "serverName": "claude.ai Google Docs"
    },
    {
      "serverName": "claude.ai Google Sheets"
    },
    {
      "serverName": "claude.ai HubSpot"
    },
    {
      "serverName": "claude.ai Intercom"
    },
    {
      "serverName": "claude.ai Linear"
    },
    {
      "serverName": "claude.ai Perplexity Computer"
    },
    {
      "serverName": "claude.ai Zoom for Claude"
    },
    {
      "serverName": "claude.ai monday.com"
    }
  ],
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); cwd=$(echo \"$input\" | jq -r '.workspace.current_dir'); branch=$(cd \"$cwd\" && git -c core.filemode=false branch --show-current 2>/dev/null); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); location=$(if [ -n \"$branch\" ]; then echo \"git:$branch\"; else echo \"$cwd\"; fi); if [ -n \"$used\" ]; then printf \"%s | ctx:%d%%\" \"$location\" \"$used\"; else echo \"$location\"; fi"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "cowork-plugin-management@inline": false,
    "cc-plugin-privacy@builtin": false
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754070055493
  },
  "modelSettings": {
    "claude-fable-5-2": {
      "effortLevel": "xhigh"
    }
  }
}
