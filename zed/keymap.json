// Zed key bindings.
[
  {
    // Markdown preview is read-only, so plain keys work like in a pager.
    "context": "MarkdownPreview",
    "bindings": {
      "j": "markdown::ScrollDown",
      "k": "markdown::ScrollUp",
      "ctrl-d": "markdown::ScrollPageDown",
      "ctrl-u": "markdown::ScrollPageUp",
      "g g": "markdown::ScrollToTop",
      "shift-g": "markdown::ScrollToBottom",
      "q": "markdown::CloseAndReturnToEditor",
      // In the preview these change the preview's font; persist keeps it
      // in settings.json (markdown_preview.font_size).
      "+": ["zed::IncreaseBufferFontSize", { "persist": true }],
      "-": ["zed::DecreaseBufferFontSize", { "persist": true }],
      "=": ["zed::ResetBufferFontSize", { "persist": true }],
      ">": ["task::Spawn", { "task_name": "Preview: wider text" }],
      "<": ["task::Spawn", { "task_name": "Preview: narrower text" }],
      "0": ["task::Spawn", { "task_name": "Preview: reset text width" }]
    }
  }
]
