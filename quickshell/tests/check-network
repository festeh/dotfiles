#!/usr/bin/env python3
"""Check the production network adapter with reactive stock-shaped QML models."""

import os
from pathlib import Path
import subprocess
import tempfile

config = Path(__file__).resolve().parents[1]
fixture = config / "tests/fixtures/network-state.qml"
with tempfile.TemporaryDirectory(prefix="quickshell-network-state-") as directory:
    root = Path(directory)
    for name in ("NetworkState.qml", "NetworkLogic.js"):
        (root / name).symlink_to(config / name)
    (root / "qmldir").write_text("singleton NetworkState 1.0 NetworkState.qml\n")
    (root / "shell.qml").write_text(fixture.read_text())
    env = dict(os.environ, QT_QPA_PLATFORM="offscreen", QT_QUICK_BACKEND="software",
        QT_IM_MODULE="compose", QT_NO_XDG_DESKTOP_PORTAL="1")
    result = subprocess.run(["quickshell", "--path", str(root)], env=env,
        capture_output=True, text=True, timeout=10)
    output = result.stdout + result.stderr
    if result.returncode or "NETWORK_STATE_PASSED" not in output:
        print(output)
        raise SystemExit("Network state check failed")
    print("Network state passed: native-model bindings, signal changes, hotspot tag updates, "
        "connectivity warnings, reconnect, Ethernet, radio blocks and missing backend.")
