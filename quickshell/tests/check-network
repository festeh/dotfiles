#!/usr/bin/env python3
"""Check native network events on a private D-Bus without touching real connections."""

import json
import os
from pathlib import Path
import subprocess
import tempfile

from gi.repository import Gio, GLib

root = Path(tempfile.mkdtemp(prefix='quickshell-network-dbus-check-'))
config = Path(__file__).resolve().parent.parent
for item in config.iterdir():
    if item.is_file() and item.name != 'shell.qml':
        (root / item.name).symlink_to(item)
(root / 'shell.qml').write_text('''import QtQuick
import Quickshell
import Quickshell.Networking
ShellRoot {
    readonly property var snapshot: NetworkStatus.snapshot
    onSnapshotChanged: Qt.callLater(report)
    function report(): void {
        const s = NetworkStatus.snapshot;
        const d = NetworkState.status;
        console.log("NETWORK_CHECK", JSON.stringify({available: s.available, ready: s.ready,
            signal: s.signal, metered: s.metered, kind: d.kind, state: d.state,
            marker: d.marker, level: d.level, severity: d.severity}));
    }
}
''')

daemon = subprocess.Popen(['dbus-daemon', '--session', '--nofork', '--print-address=1'],
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
address = daemon.stdout.readline().strip()
bus = Gio.DBusConnection.new_for_address_sync(address,
    Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION,
    None, None)
nm = 'org.freedesktop.NetworkManager'
manager = '/org/freedesktop/NetworkManager'
device = manager + '/Devices/1'
active = manager + '/ActiveConnection/1'
ap = manager + '/AccessPoint/1'
dev_iface = nm + '.Device'
wifi_iface = dev_iface + '.Wireless'
active_iface = nm + '.Connection.Active'
ap_iface = nm + '.AccessPoint'
login = 'org.freedesktop.login1'

def request_name(name, release=False):
    return bus.call_sync('org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus',
        'ReleaseName' if release else 'RequestName',
        GLib.Variant('(s)', (name,)) if release else GLib.Variant('(su)', (name, 0)),
        GLib.VariantType('(u)'), Gio.DBusCallFlags.NONE, -1, None)

def variant(signature, value):
    return GLib.Variant(signature, value)

data = {
    (manager, nm): {
        'Devices': variant('ao', [device]), 'PrimaryConnection': variant('o', active),
        'ActivatingConnection': variant('o', '/'), 'State': variant('u', 70),
        'NetworkingEnabled': variant('b', True), 'WirelessEnabled': variant('b', True),
        'WirelessHardwareEnabled': variant('b', True), 'Connectivity': variant('u', 4),
        'ConnectivityCheckAvailable': variant('b', True), 'ConnectivityCheckEnabled': variant('b', True),
    },
    (device, dev_iface): {'DeviceType': variant('u', 2), 'State': variant('u', 100),
        'ActiveConnection': variant('o', active), 'Interface': variant('s', 'mock-wifi'), 'Metered': variant('u', 2)},
    (device, wifi_iface): {'ActiveAccessPoint': variant('o', ap)},
    (active, active_iface): {'Devices': variant('ao', [device]), 'Id': variant('s', 'Example Wi-Fi')},
    (ap, ap_iface): {'Ssid': variant('ay', list(b'Example Wi-Fi')),
        'Strength': variant('y', 36), 'Frequency': variant('u', 5180)},
}
reads = 0

def get_property(connection, sender, path, interface, name):
    global reads
    reads += 1
    return data[path, interface][name]

registrations = []
for (path, interface), properties in data.items():
    xml = '<node><interface name="' + interface + '">' + ''.join(
        '<property name="' + name + '" type="' + value.get_type_string() + '" access="read"/>'
        for name, value in properties.items()) + '</interface></node>'
    info = Gio.DBusNodeInfo.new_for_xml(xml).interfaces[0]
    registrations.append(bus.register_object(path, info, None, get_property, None))

request_name(nm)
request_name(login)

def update(path, interface, values):
    data[path, interface].update(values)
    bus.emit_signal(None, path, 'org.freedesktop.DBus.Properties', 'PropertiesChanged',
        GLib.Variant('(sa{sv}as)', (interface, values, [])))

def resume():
    data[ap, ap_iface]['Strength'] = variant('y', 44)
    bus.emit_signal(None, '/org/freedesktop/login1', login + '.Manager',
                    'PrepareForSleep', GLib.Variant('(b)', (False,)))

def disable():
    data[device, dev_iface]['State'] = variant('u', 30)
    update(manager, nm, {'WirelessEnabled': variant('b', False),
        'PrimaryConnection': variant('o', '/'), 'State': variant('u', 30)})
    update(device, dev_iface, {'State': variant('u', 30)})

steps = [
    ('initial live snapshot', lambda s: s.get('ready') and s['signal'] == .36 and s['kind'] == 'wifi',
        lambda: update(ap, ap_iface, {'Strength': variant('y', 90)})),
    ('signal property update', lambda s: s.get('ready') and s['signal'] == .9 and s['level'] == 3,
        lambda: update(device, dev_iface, {'Metered': variant('u', 1)})),
    ('metered to phone classification', lambda s: s.get('kind') == 'phone' and s.get('metered') == 1,
        lambda: update(manager, nm, {'Connectivity': variant('u', 2)})),
    ('captive portal warning', lambda s: s.get('marker') == 'warning' and s.get('severity') == 'attention', resume),
    ('resume refresh without property signal', lambda s: s.get('ready') and s.get('signal') == .44,
        lambda: request_name(nm, release=True)),
    ('NetworkManager disappearance', lambda s: s.get('available') is False and s['state'] == 'unknown',
        lambda: request_name(nm)),
    ('NetworkManager restart', lambda s: s.get('ready') and s.get('signal') == .44 and s['kind'] == 'phone',
        lambda: update(device, dev_iface, {'Metered': variant('u', 0)})),
    ('unknown metering retains phone recognition', lambda s: s.get('ready') and s.get('metered') == 0 and s['kind'] == 'phone',
        lambda: update(device, dev_iface, {'Metered': variant('u', 2)})),
    ('known unmetered update clears phone classification', lambda s: s.get('ready') and s.get('metered') == 2 and s['kind'] == 'wifi', disable),
    ('disabled Wi-Fi', lambda s: s.get('ready') and s.get('state') == 'disabled', None),
]
step = 0
failure = None
buffer = ''
logs = []
loop = GLib.MainLoop()
env = os.environ | {'DBUS_SYSTEM_BUS_ADDRESS': address, 'XDG_CACHE_HOME': str(root / 'cache')}
child = subprocess.Popen(['quickshell', '--path', str(root)], stdout=subprocess.PIPE,
                         stderr=subprocess.STDOUT, env=env)
os.set_blocking(child.stdout.fileno(), False)

def fail(message):
    global failure
    failure = message
    loop.quit()
    return GLib.SOURCE_REMOVE

def idle_check():
    before = reads
    def verify():
        if reads != before:
            return fail('Unexpected property reads while idle')
        cache = json.loads((root / 'cache/quickshell/network-types.json').read_text())
        if len(cache) != 1 or not all(len(key) == 64 and value is False for key, value in cache.items()):
            return fail('Classification cache did not contain the expected hashed entry')
        print('PASS: no idle property polling; hashed classification cache')
        loop.quit()
        return GLib.SOURCE_REMOVE
    GLib.timeout_add(1000, verify)
    return GLib.SOURCE_REMOVE

def consume(fd, condition):
    global buffer, step
    try:
        chunk = os.read(fd, 65536)
        if not chunk:
            return fail('Quickshell exited before checks completed')
        buffer += chunk.decode()
        while '\n' in buffer:
            line, buffer = buffer.split('\n', 1)
            logs.append(line)
            if 'NETWORK_CHECK ' not in line or step == len(steps):
                continue
            snapshot = json.loads(line.split('NETWORK_CHECK ', 1)[1])
            name, predicate, action = steps[step]
            if predicate(snapshot):
                print('PASS:', name, flush=True)
                step += 1
                if action:
                    action()
                else:
                    GLib.timeout_add(250, idle_check)
    except Exception as error:
        return fail(str(error))
    return GLib.SOURCE_CONTINUE

GLib.io_add_watch(child.stdout.fileno(), GLib.IO_IN | GLib.IO_HUP, consume)
GLib.timeout_add(12000, lambda: fail('Timed out at check: ' + (steps[step][0] if step < len(steps) else 'idle')))
try:
    loop.run()
finally:
    child.terminate()
    child.wait(timeout=3)
    bus.close_sync(None)
    daemon.terminate()
    daemon.wait(timeout=3)
if failure:
    print('\n'.join(logs[-12:]))
    raise SystemExit(failure)
print('All native network D-Bus checks passed. The real system bus was not used.')
