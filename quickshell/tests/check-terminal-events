#!/usr/bin/python3
"""Real Kitty tabs/splits and production tracker, using only synthetic agents."""

import asyncio
import json
import os
from pathlib import Path
import sys
import tempfile

source = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(source))
from terminal_tracker import kitty_request


async def main():
    with tempfile.TemporaryDirectory(prefix="quickshell-terminal-check-") as directory:
        root = Path(directory)
        runtime = root / "runtime"
        runtime.mkdir(mode=0o700)
        env = dict(os.environ, XDG_RUNTIME_DIR=str(runtime),
            WAYLAND_DISPLAY=str(Path(os.environ["XDG_RUNTIME_DIR"]) / os.environ["WAYLAND_DISPLAY"]))
        program = ('#!/usr/bin/python3\nimport sys\n'
            'print("\\x1b]0;Test agent\\x07",end="",flush=True)\n'
            'while True:\n with open(sys.argv[1]) as control:\n'
            '  for line in control:\n'
            '   value=line.rstrip("\\n")\n'
            '   if value.startswith("FOOTER:"):\n'
            '    print("\\x1b7\\x1b[999;1H\\x1b[2K"+value[7:]+"\\x1b8",end="",flush=True)\n'
            '   else: print("\\x1b]0;"+value+"\\x07",end="",flush=True)\n')
        for name in ("codex", "claude", "agy"):
            (root / name).write_text(program)
            (root / name).chmod(0o700)
        for name in ("one", "two", "three", "four", "five"):
            os.mkfifo(root / name)
        log = (root / "kitty.log").open("w+")
        kitty = await asyncio.create_subprocess_exec("kitty", "--config", "NONE", "--class", "quickshell-terminal-check",
            "--listen-on", "unix:@kitty-{kitty_pid}", "-o", "allow_remote_control=yes", "-o", "font_size=10",
            str(root / "codex"), str(root / "one"), env=env, stdout=log, stderr=log)
        worker = None
        latest = None

        async def start():
            nonlocal worker
            worker = await asyncio.create_subprocess_exec("/usr/bin/python3", str(source / "terminal_tracker.py"), env=env,
                stdin=asyncio.subprocess.PIPE, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE)
            worker.stdin.write(json.dumps({"windows": [dict(pid=kitty.pid, address="a1", appId="quickshell-terminal-check")]}).encode() + b"\n")
            await worker.stdin.drain()

        async def wait(predicate, timeout=6):
            nonlocal latest
            deadline = asyncio.get_running_loop().time() + timeout
            while True:
                line = await asyncio.wait_for(worker.stdout.readline(), deadline - asyncio.get_running_loop().time())
                if not line:
                    raise RuntimeError((await worker.stderr.read()).decode())
                latest = json.loads(line)
                if predicate(latest):
                    return latest

        def state(value):
            return value["windows"].get("a1", {}).get("agentState")

        def title(name, value):
            descriptor = os.open(root / name, os.O_WRONLY | os.O_NONBLOCK)
            try:
                os.write(descriptor, (value + "\n").encode())
            finally:
                os.close(descriptor)

        def activity(value, pane):
            return next(agent.get('activity') for agent in value['windows']['a1']['agents'] if agent['pane'] == pane)

        async def hook(pane, event):
            process = await asyncio.create_subprocess_exec("/usr/bin/python3", str(source / "agent-hook"), "claude",
                env=dict(env, KITTY_PID=str(kitty.pid), KITTY_WINDOW_ID=str(pane)), stdin=asyncio.subprocess.PIPE,
                stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE)
            stdout, stderr = await process.communicate(json.dumps(dict(session_id="fixture", hook_event_name=event)).encode())
            assert process.returncode == 0 and not stdout and not stderr, (stdout, stderr)

        try:
            for _ in range(100):
                try:
                    await kitty_request(kitty.pid)
                    break
                except (OSError, ValueError):
                    await asyncio.sleep(.03)
            await start()
            await wait(lambda value: value["health"]["watched"] == 1 and value["health"]["agents"] == 1
                and value["windows"]["a1"]["agents"][0]["label"])
            title('one', 'Refactor upload cache | fixture-project')
            await wait(lambda value: value['windows']['a1']['agents'][0]['fullLabel'] == 'Refactor upload cache')
            await kitty_request(kitty.pid, "launch", dict(args=[str(root / "codex"), str(root / "two")], type="tab", keep_focus=True))
            third = int(await kitty_request(kitty.pid, "launch", dict(args=[str(root / "claude"), str(root / "three")], type="tab", keep_focus=True)))
            await wait(lambda value: value["health"]["agents"] == 3)
            await hook(third, "SessionStart")
            await wait(lambda value: state(value) == "idle")
            title('three', '✳ Refresh search index')
            await wait(lambda value: any(agent['pane'] == third and agent['fullLabel'] == 'Refresh search index'
                for agent in value['windows']['a1']['agents']))
            title("two", "⠋ Test agent")
            await wait(lambda value: state(value) == "running")
            await hook(third, "PermissionRequest")
            await wait(lambda value: state(value) == "waiting")
            worker.stdin.write(json.dumps({"activate": {"address": "a1", "pane": third}}).encode() + b"\n")
            await worker.stdin.drain()
            await wait(lambda value: value.get("activated", {}).get("ok"))
            await wait(lambda value: any(agent["pane"] == third and agent["active"]
                for agent in value.get("windows", {}).get("a1", {}).get("agents", [])))
            worker.stdin.write(json.dumps({"rename": {"address": "a1", "pane": third, "label": "shell/auth"}}).encode() + b"\n")
            await worker.stdin.drain()
            await wait(lambda value: value.get("renamed", {}).get("ok"))
            await wait(lambda value: any(agent["pane"] == third and agent["label"] == "shell/auth"
                for agent in value.get("windows", {}).get("a1", {}).get("agents", [])))
            await hook(third, "PostToolUse")
            await wait(lambda value: state(value) == "running")
            await hook(third, "Stop")
            await wait(lambda value: state(value) == "running" and value["windows"]["a1"]["agents"][-1]["state"] == "idle")
            title("two", "Test agent")
            await wait(lambda value: state(value) == "idle")
            first = latest['windows']['a1']['agents'][0]['pane']
            await kitty_request(kitty.pid, "focus-window", {"match": f"id:{first}"})
            # No hook or title changes: the inactive pane's footer is the source.
            title('three', 'FOOTER:⏵⏵ bypass permissions on · 2 shells, 2 monitors')
            counts = dict(agents=0, shells=2, monitors=2)
            await wait(lambda value: activity(value, third) == counts and state(value) == 'idle')
            assert 'bypass permissions' not in json.dumps(latest)
            title('three', 'FOOTER:⏵⏵ bypass permissions on · 1 shell')
            await wait(lambda value: activity(value, third) == dict(agents=0, shells=1, monitors=0))
            title('three', 'FOOTER:Choose an option')
            await wait(lambda value: activity(value, third) is None)
            title('three', 'FOOTER:⏵⏵ bypass permissions on')
            await wait(lambda value: activity(value, third) == dict(agents=0, shells=0, monitors=0))
            second_claude = int(await kitty_request(kitty.pid, "launch",
                dict(args=[str(root / "claude"), str(root / "five")], type="tab", keep_focus=True)))
            await wait(lambda value: value['health']['agents'] == 4)
            title('five', '✳ Secondary session')
            title('five', 'FOOTER:⏵⏵ bypass permissions on · 3 agents')
            await wait(lambda value: activity(value, second_claude) == dict(agents=3, shells=0, monitors=0)
                and activity(value, third) == dict(agents=0, shells=0, monitors=0))
            await kitty_request(kitty.pid, "close-window", {"match": f"id:{second_claude}"})
            await wait(lambda value: value['health']['agents'] == 3 and state(value) == 'idle')
            title('three', 'FOOTER:⏵⏵ bypass permissions on · 2 monitors')
            await wait(lambda value: activity(value, third) == dict(agents=0, shells=0, monitors=2))
            fourth = int(await kitty_request(kitty.pid, "launch", dict(args=[str(root / "agy"), str(root / "four")], type="window", keep_focus=True)))
            await wait(lambda value: value["health"]["agents"] == 4)
            def fourth_state(value, expected):
                return any(agent['pane'] == fourth and agent['agent'] == 'antigravity'
                    and agent['state'] == expected for agent in value['windows']['a1']['agents'])
            title("four", "[agy:idle] fixture-project")
            await wait(lambda value: state(value) == "idle" and fourth_state(value, 'idle'))
            title("four", "[agy:running] fixture-project")
            await wait(lambda value: state(value) == "running" and fourth_state(value, 'running'))
            title("four", "[agy:waiting] fixture-project")
            await wait(lambda value: state(value) == "waiting" and fourth_state(value, 'waiting'))
            await kitty_request(kitty.pid, "close-window", {"match": f"id:{fourth}"})
            await wait(lambda value: state(value) == "idle" and value["health"]["agents"] == 3)

            # Restart the tracker, retaining Kitty and the inactive agent panes.
            worker.stdin.close()
            await asyncio.wait_for(worker.wait(), 5)
            await start()
            await wait(lambda value: value["health"]["watched"] == 1 and value["health"]["agents"] == 3
                and value['windows']['a1']['agents'][0]['fullLabel'] == 'Refactor upload cache'
                and activity(value, third) == dict(agents=0, shells=0, monitors=2)
                and any(agent['pane'] == third and agent['label'] == 'shell/auth'
                    for agent in value['windows']['a1']['agents']))
            title("two", "⠋ Test agent")
            await wait(lambda value: state(value) == "running")
            title("two", "\n".join(frame + " Test agent" for frame in ["⠙", "⠹", "⠸", "⠼"] * 25))
            try:
                line = await asyncio.wait_for(worker.stdout.readline(), 2.3)
                raise AssertionError("Spinner-only frames or idle polling published: " + line.decode())
            except asyncio.TimeoutError:
                pass
            assert latest["health"]["requests"] == 1, latest["health"]
            await kitty_request(kitty.pid, "close-window", {"match": f"id:{third}"})
            await wait(lambda value: value['health']['agents'] == 2
                and value['health']['claudeActivity']['known'] == value['health']['claudeActivity']['unknown'] == 0)
            print("PASS: existing-pane attachment, inactive tabs, split panes, exact-pane activation, labels, hooks, Antigravity states, Claude footer-only starts/stops, hidden/empty footers, independent Claude panes, count recovery after restart and zero spinner/unchanged-footer queries.")
        except Exception:
            print("Last synthetic state:", latest)
            log.seek(0)
            print(log.read()[-4000:])
            raise
        finally:
            if kitty.returncode is None:
                kitty.terminate()
                await asyncio.wait_for(kitty.wait(), 5)
            if worker is not None and worker.returncode is None:
                worker.stdin.close()
                await asyncio.wait_for(worker.wait(), 5)


asyncio.run(main())
