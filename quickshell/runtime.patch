+#pragma once
+
+#include <qdbusconnection.h>
+#include <qdbuscontext.h>
+#include <qdbusservicewatcher.h>
+#include <qhash.h>
+#include <qobject.h>
+#include <qqmlintegration.h>
+#include <qset.h>
+#include <qvariant.h>
+
+namespace qs::network {
+
+///! Read-only status of NetworkManager's primary connection.
+/// Observes existing state without requesting scans or changing connections.
+class NetworkStatus: public QObject, protected QDBusContext {
+	Q_OBJECT;
+	QML_ELEMENT;
+	QML_SINGLETON;
+	Q_PROPERTY(QVariantMap snapshot READ snapshot NOTIFY snapshotChanged);
+
+public:
+	explicit NetworkStatus(QObject* parent = nullptr);
+	[[nodiscard]] QVariantMap snapshot() const { return this->mSnapshot; }
+
+signals:
+	void snapshotChanged();
+
+private slots:
+	void propertiesChanged(const QString& interface, const QVariantMap& changed, const QStringList& invalidated);
+	void inventoryChanged();
+	void prepareForSleep(bool sleeping);
+
+private:
+	void restart(bool available);
+	void fetch(const QString& path, const QString& interface, bool force = false);
+	void reconcile();
+	void loadPhoneCache();
+	void savePhoneCache();
+
+	QDBusConnection bus;
+	QDBusServiceWatcher watcher;
+	bool mAvailable = false;
+	quint64 mGeneration = 0;
+	quint64 mRevision = 0;
+	QVariantMap mSnapshot;
+	QHash<QString, QVariantMap> mCache;
+	QHash<QString, QHash<QString, quint64>> mVersions;
+	QSet<QString> mWanted, mLoaded, mPending, mErrors, mAgain;
+	QHash<QString, bool> mPhoneCache;
+	QString mCachePath;
+};
+
+} // namespace qs::network
