@@ -0,0 +1,275 @@
+#include "status.hpp"
+
+#include <qcryptographichash.h>
+#include <qdbusconnectioninterface.h>
+#include <qdbusmessage.h>
+#include <qdbusmetatype.h>
+#include <qdbuspendingcall.h>
+#include <qdbuspendingreply.h>
+#include <qdebug.h>
+#include <qdir.h>
+#include <qfile.h>
+#include <qfileinfo.h>
+#include <qjsondocument.h>
+#include <qjsonobject.h>
+#include <qsavefile.h>
+#include <qstandardpaths.h>
+
+namespace qs::network {
+namespace {
+const QString service = QStringLiteral("org.freedesktop.NetworkManager");
+const QString managerPath = QStringLiteral("/org/freedesktop/NetworkManager");
+const QString deviceInterface = service + ".Device";
+const QString wirelessInterface = deviceInterface + ".Wireless";
+const QString activeInterface = service + ".Connection.Active";
+const QString apInterface = service + ".AccessPoint";
+const QString propertiesInterface = QStringLiteral("org.freedesktop.DBus.Properties");
+
+QString key(const QString& path, const QString& interface) { return path + '\n' + interface; }
+QString objectPath(const QVariant& value) { return qdbus_cast<QDBusObjectPath>(value).path(); }
+bool realPath(const QString& path) { return !path.isEmpty() && path != "/"; }
+QList<QDBusObjectPath> objectPaths(const QVariant& value) {
+	return qdbus_cast<QList<QDBusObjectPath>>(value);
+}
+}
+
+NetworkStatus::NetworkStatus(QObject* parent): QObject(parent), bus(QDBusConnection::systemBus()) {
+	this->loadPhoneCache();
+	this->watcher.setConnection(this->bus);
+	this->watcher.setWatchMode(QDBusServiceWatcher::WatchForOwnerChange);
+	this->watcher.addWatchedService(service);
+	QObject::connect(&this->watcher, &QDBusServiceWatcher::serviceOwnerChanged, this,
+	    [this](const QString&, const QString&, const QString& owner) { this->restart(!owner.isEmpty()); });
+
+	this->bus.connect(service, QString(), propertiesInterface, "PropertiesChanged", this,
+	    SLOT(propertiesChanged(QString,QVariantMap,QStringList)));
+	this->bus.connect(service, managerPath, service, "DeviceAdded", this, SLOT(inventoryChanged()));
+	this->bus.connect(service, managerPath, service, "DeviceRemoved", this, SLOT(inventoryChanged()));
+	this->bus.connect("org.freedesktop.login1", "/org/freedesktop/login1",
+	    "org.freedesktop.login1.Manager", "PrepareForSleep", this, SLOT(prepareForSleep(bool)));
+
+	this->reconcile();
+	if (this->bus.interface()) {
+		auto generation = this->mGeneration;
+		auto* call = new QDBusPendingCallWatcher(this->bus.interface()->asyncCall("NameHasOwner", service), this);
+		QObject::connect(call, &QDBusPendingCallWatcher::finished, this, [this, generation](auto* call) {
+			QDBusPendingReply<bool> reply = *call;
+			if (generation == this->mGeneration) this->restart(!reply.isError() && reply.value());
+			call->deleteLater();
+		});
+	}
+}
+
+void NetworkStatus::restart(bool available) {
+	++this->mGeneration;
+	this->mAvailable = available;
+	this->mCache.clear();
+	this->mVersions.clear();
+	this->mWanted.clear();
+	this->mLoaded.clear();
+	this->mPending.clear();
+	this->mErrors.clear();
+	this->mAgain.clear();
+	this->reconcile();
+}
+
+void NetworkStatus::prepareForSleep(bool sleeping) {
+	if (!sleeping) this->restart(this->mAvailable);
+}
+
+void NetworkStatus::inventoryChanged() { this->fetch(managerPath, service, true); }
+
+void NetworkStatus::fetch(const QString& path, const QString& interface, bool force) {
+	if (!this->mAvailable) return;
+	auto id = key(path, interface);
+	if (this->mPending.contains(id)) {
+		if (force) this->mAgain.insert(id);
+		return;
+	}
+	this->mPending.insert(id);
+	auto generation = this->mGeneration;
+	auto revision = this->mRevision;
+	auto message = QDBusMessage::createMethodCall(service, path, propertiesInterface, "GetAll");
+	message << interface;
+	auto* call = new QDBusPendingCallWatcher(this->bus.asyncCall(message), this);
+	QObject::connect(call, &QDBusPendingCallWatcher::finished, this,
+	    [this, id, path, interface, generation, revision](auto* call) {
+		QDBusPendingReply<QVariantMap> reply = *call;
+		call->deleteLater();
+		if (generation != this->mGeneration) return;
+		this->mPending.remove(id);
+		if (!this->mWanted.contains(id)) return;
+		this->mLoaded.insert(id);
+		if (reply.isError()) {
+			this->mErrors.insert(id);
+		} else {
+			this->mErrors.remove(id);
+			// A signal may arrive while GetAll is in flight. Preserve newer fields.
+			const auto fields = reply.value();
+			for (auto it = fields.cbegin(); it != fields.cend(); ++it) {
+				if (this->mVersions.value(id).value(it.key()) <= revision)
+					this->mCache[id].insert(it.key(), it.value());
+			}
+		}
+		if (this->mAgain.remove(id)) this->fetch(path, interface);
+		this->reconcile();
+	});
+}
+
+void NetworkStatus::propertiesChanged(const QString& interface, const QVariantMap& changed,
+                                    const QStringList& invalidated) {
+	const auto path = this->message().path();
+	const auto id = key(path, interface);
+	if (!this->mWanted.contains(id)) return;
+	const auto revision = ++this->mRevision;
+	for (auto it = changed.cbegin(); it != changed.cend(); ++it) {
+		this->mCache[id].insert(it.key(), it.value());
+		this->mVersions[id].insert(it.key(), revision);
+	}
+	for (const auto& field: invalidated) {
+		this->mCache[id].remove(field);
+		this->mVersions[id].insert(field, revision);
+	}
+	if (!invalidated.isEmpty() || this->mErrors.contains(id)) this->fetch(path, interface, true);
+	this->reconcile();
+}
+
+void NetworkStatus::reconcile() {
+	QVariantMap status {{"available", this->mAvailable}, {"ready", false}};
+	QSet<QString> wanted;
+	bool complete = true;
+	auto read = [&](const QString& path, const QString& interface, bool required = true) {
+		auto id = key(path, interface);
+		wanted.insert(id);
+		if (!this->mLoaded.contains(id)) this->fetch(path, interface);
+		if (required && (!this->mLoaded.contains(id) || this->mErrors.contains(id))) complete = false;
+		return this->mCache.value(id);
+	};
+
+	if (this->mAvailable) {
+		const auto manager = read(managerPath, service);
+		const auto primary = objectPath(manager.value("PrimaryConnection"));
+		const auto activating = objectPath(manager.value("ActivatingConnection"));
+		auto connectionPath = realPath(primary) ? primary : activating;
+		QVariantMap connection;
+		if (realPath(connectionPath)) connection = read(connectionPath, activeInterface);
+
+		QString selectedPath;
+		QVariantMap selected;
+		bool hasWifi = false;
+		int bestScore = -1;
+		for (const auto& path: objectPaths(manager.value("Devices"))) {
+			const auto device = read(path.path(), deviceInterface, !realPath(connectionPath));
+			const auto type = device.value("DeviceType").toUInt();
+			hasWifi |= type == 2;
+			if (type != 1 && type != 2) continue;
+			if (realPath(connectionPath)) continue;
+			const auto state = device.value("State").toUInt();
+			int score = state >= 40 && state <= 90 ? 100 : state == 120 ? 90 : state == 100 ? 80 : 0;
+			score += type == 2 ? 2 : 1;
+			if (score > bestScore) {
+				bestScore = score;
+				selectedPath = path.path();
+				selected = device;
+			}
+		}
+
+		if (realPath(connectionPath)) {
+			const auto devices = objectPaths(connection.value("Devices"));
+			for (const auto& path: devices) {
+				const auto device = read(path.path(), deviceInterface);
+				const auto type = device.value("DeviceType").toUInt();
+				if (selectedPath.isEmpty() || type == 1 || type == 2) {
+					selectedPath = path.path();
+					selected = device;
+				}
+				if (type == 1 || type == 2) break;
+			}
+		} else if (!selectedPath.isEmpty()) {
+			connectionPath = objectPath(selected.value("ActiveConnection"));
+			if (realPath(connectionPath)) connection = read(connectionPath, activeInterface);
+		}
+
+		const auto type = selected.value("DeviceType").toUInt();
+		status.insert("type", type == 2 ? "wifi" : type == 1 ? "wired" : realPath(connectionPath) ? "other" : "");
+		status.insert("hasWifi", hasWifi || type == 2);
+		status.insert("deviceState", selected.value("State", 0));
+		status.insert("interfaceName", selected.value("Interface"));
+		status.insert("networkState", manager.value("State", 0));
+		status.insert("networkingEnabled", manager.value("NetworkingEnabled", true));
+		status.insert("wifiEnabled", manager.value("WirelessEnabled", false));
+		status.insert("wifiHardwareEnabled", manager.value("WirelessHardwareEnabled", false));
+		status.insert("connectivity", manager.value("Connectivity", 0));
+		status.insert("canCheckConnectivity", manager.value("ConnectivityCheckAvailable", false));
+		status.insert("connectivityCheckEnabled", manager.value("ConnectivityCheckEnabled", false));
+		status.insert("metered", selected.value("Metered", 0));
+		status.insert("name", connection.value("Id"));
+		status.insert("signal", -1.0);
+		status.insert("frequency", 0);
+		status.insert("phone", false);
+
+		QByteArray ssid;
+		if (type == 2) {
+			const auto wireless = read(selectedPath, wirelessInterface);
+			const auto apPath = objectPath(wireless.value("ActiveAccessPoint"));
+			if (realPath(apPath)) {
+				const auto ap = read(apPath, apInterface);
+				ssid = qdbus_cast<QByteArray>(ap.value("Ssid"));
+				status.insert("name", QString::fromUtf8(ssid));
+				status.insert("signal", ap.contains("Strength") ? ap.value("Strength").toDouble() / 100.0 : -1.0);
+				status.insert("frequency", ap.value("Frequency", 0));
+			}
+		}
+		status.insert("ready", complete);
+		if (complete && !ssid.isEmpty() && selected.value("State").toUInt() == 100) {
+			// Keep recognition across reconnects without storing SSIDs in this cache.
+			auto cacheKey = QString::fromLatin1(QCryptographicHash::hash(ssid, QCryptographicHash::Sha256).toHex());
+			auto metered = selected.value("Metered").toUInt();
+			if (metered >= 1 && metered <= 4) {
+				bool phone = metered == 1 || metered == 3;
+				if (!this->mPhoneCache.contains(cacheKey) || this->mPhoneCache.value(cacheKey) != phone) {
+					this->mPhoneCache.insert(cacheKey, phone);
+					this->savePhoneCache();
+				}
+			}
+			status.insert("phone", this->mPhoneCache.value(cacheKey, false));
+		}
+	}
+	this->mWanted = wanted;
+	for (const auto& id: this->mCache.keys()) {
+		if (!wanted.contains(id)) {
+			this->mCache.remove(id);
+			this->mLoaded.remove(id);
+			this->mVersions.remove(id);
+			this->mErrors.remove(id);
+		}
+	}
+	if (status != this->mSnapshot) {
+		this->mSnapshot = status;
+		emit this->snapshotChanged();
+	}
+}
+
+void NetworkStatus::loadPhoneCache() {
+	this->mCachePath = QStandardPaths::writableLocation(QStandardPaths::GenericCacheLocation)
+	    + "/quickshell/network-types.json";
+	QFile file(this->mCachePath);
+	if (!file.open(QIODevice::ReadOnly)) return;
+	const auto object = QJsonDocument::fromJson(file.readAll()).object();
+	for (auto it = object.begin(); it != object.end(); ++it) {
+		if (it.key().size() == 64 && it.value().isBool()) this->mPhoneCache.insert(it.key(), it.value().toBool());
+	}
+}
+
+void NetworkStatus::savePhoneCache() {
+	QDir().mkpath(QFileInfo(this->mCachePath).absolutePath());
+	QSaveFile file(this->mCachePath);
+	if (!file.open(QIODevice::WriteOnly)) return;
+	file.setPermissions(QFileDevice::ReadOwner | QFileDevice::WriteOwner);
+	QJsonObject object;
+	for (auto it = this->mPhoneCache.cbegin(); it != this->mPhoneCache.cend(); ++it) object.insert(it.key(), it.value());
+	file.write(QJsonDocument(object).toJson(QJsonDocument::Compact));
+	file.commit();
+}
+
